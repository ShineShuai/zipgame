{
  "name": "zip-puzzle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node test/check.js && node test/check-config.js",
    "test": "node test/tests.js",
    "test:server": "node server/cloudflare/worker.test.mjs && node server/turso/schema.test.mjs",
    "bench": "node bench/bench.js",
    "bench:save": "node bench/bench.js --save",
    "bench:report": "node bench/report.mjs",
    "test:bench": "node --test bench/results.test.js",
    "test:coop": "node --test test/coop/drawing.test.js test/coop/stroke.test.js test/coop/hint.test.js test/coop/view.test.js test/coop/texts-stats.test.js test/coop/cut.test.js test/coop/replica.test.js test/coop/invite.test.js test/coop/session.test.js test/coop/pages.test.js",
    "golden": "node test/print-golden.js",
    "share:decode": "node tools/share-decode.mjs",
    "dev:link": "node tools/dev-link.mjs",
    "gotd:fit": "node tools/gotd-fit.mjs",
    "target:eval": "node tools/target-eval.mjs",
    "size:level": "node tools/size-level.mjs",
    "gotd:seed": "node tools/gotd-seed.mjs --dry-run",
    "behaviour": "node tools/behaviour.mjs"
  }
}
