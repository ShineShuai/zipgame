{
  "name": "zip-puzzle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node test/check.js && node test/check-config.js && node test/check-width.js",
    "width:update": "node test/check-width.js --update",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint --error-on-warnings",
    "test": "node test/run.mjs fast",
    "test:slow": "node test/run.mjs slow",
    "test:all": "node test/run.mjs all",
    "test:sync": "node test/run.mjs all sync",
    "test:gotd": "node test/run.mjs all cli",
    "test:tools": "node --test test/tools.test.js",
    "fixtures:puzzles": "node test/fixtures/build-puzzles.mjs",
    "fixtures:step-ratings": "node test/fixtures/build-step-ratings.mjs",
    "test:server": "node server/cloudflare/worker.test.mjs && node server/turso/schema.test.mjs && node server/turso/sync.test.mjs",
    "bench": "node bench/bench.js",
    "bench:save": "node bench/bench.js --save",
    "bench:report": "node bench/report.mjs",
    "test:bench": "node --test bench/results.test.js",
    "test:coop": "node test/run.mjs all coop",
    "golden": "node test/print-golden.js",
    "share:decode": "node tools/share-decode.mjs",
    "dev:link": "node tools/dev-link.mjs",
    "gotd:fit": "node tools/gotd-fit.mjs",
    "target:eval": "node tools/target-eval.mjs",
    "size:level": "node tools/size-level.mjs",
    "gotd:seed": "node tools/gotd-seed.mjs --dry-run",
    "gotd:gen": "node tools/gotd-gen.mjs",
    "behaviour": "node tools/behaviour.mjs",
    "behaviour:eval": "node tools/behaviour-eval.mjs",
    "calib:set": "node tools/calib-set.mjs",
    "step:fit": "node tools/step-fit.mjs",
    "step:sim": "node tools/step-sim.mjs",
    "points:apply": "node tools/apply-points.mjs",
    "test:themes": "node ../themes/tools/test.mjs",
    "themes:pack": "node ../themes/tools/pack.mjs",
    "themes:preview": "node ../themes/tools/serve.mjs",
    "themes": "node ../themes/tools/manage.mjs",
    "themes:import": "node ../themes/tools/import-proto.mjs",
    "themes:build": "node ../themes/tools/build-site.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
